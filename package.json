{
  "name": "codex-multifile-drop",
  "displayName": "Codex File Drop",
  "description": "Drag or batch-add files and folders from VS Code or Cursor Explorer to the current Codex thread, including over Remote-SSH.",
  "version": "0.2.2",
  "publisher": "youngdubbydu",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoungDubbyDu/codex-multifile-drop.git"
  },
  "homepage": "https://github.com/YoungDubbyDu/codex-multifile-drop#readme",
  "bugs": {
    "url": "https://github.com/YoungDubbyDu/codex-multifile-drop/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#06152f",
    "theme": "dark"
  },
  "keywords": [
    "codex",
    "openai",
    "vscode",
    "cursor",
    "file",
    "folder",
    "explorer",
    "drag-and-drop",
    "multi-file",
    "remote-ssh",
    "attachment",
    "context"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "2.26.1"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "activationEvents": [
    "onView:codexMultiFileDrop.dropZone",
    "onCommand:codexMultiFileDrop.addSelectedFiles",
    "onCommand:codexMultiFileDrop.pickFiles"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexMultiFileDrop.addSelectedFiles",
        "title": "Codex: Add ALL Selected Files to Current Thread",
        "category": "Codex",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codexMultiFileDrop.pickFiles",
        "title": "Codex: Pick Multiple Files for Current Thread",
        "category": "Codex",
        "icon": "$(files)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codexMultiFileDrop.addSelectedFiles",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "2_workspace@100"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "codexMultiFileDrop.dropZone",
          "name": "CODEX: DROP FILES HERE",
          "when": "workspaceFolderCount != 0"
        }
      ]
    }
  }
}
